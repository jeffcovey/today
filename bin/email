#!/usr/bin/env node

// Auto-use dotenvx if available
import { autoDotenvx } from './lib/dotenvx-loader.js';
autoDotenvx();

import { getDatabase } from '../src/database-service.js';
import { addExactSourceCondition, getImapPasswordEnvKey, newestUids, rankSearchResults, searchableFolders, withConnectedImapClient } from '../src/email-cli-utils.js';
import { ensureSyncForType, getSyncStatusMessage } from '../src/plugin-loader.js';
import { getConfigPath } from '../src/config.js';
import { program } from 'commander';
import { colors } from '../src/cli-utils.js';

program
  .name('email')
  .description('Email management CLI - queries emails synced by imap-email plugin');

// Stats command - show email database statistics
program
  .command('stats')
  .description('Show email database statistics')
  .action(async () => {
    const db = getDatabase();
    await ensureSyncForType(db, 'email');

    console.log(colors.blue('📊 Email Database Statistics'));

    const stats = db.prepare(`
      SELECT
        COUNT(*) as total,
        MIN(date) as oldest,
        MAX(date) as newest,
        SUM(size) as total_size
      FROM email
    `).get();

    if (stats.total === 0) {
      console.log(colors.yellow('No emails synced yet.'));
      console.log('Run "bin/plugins sync imap-email" to sync emails.');
      return;
    }

    console.log(colors.green(`\nTotal emails: ${stats.total}`));
    console.log(colors.gray(`Oldest email: ${stats.oldest ? new Date(stats.oldest).toLocaleDateString() : 'N/A'}`));
    console.log(colors.gray(`Newest email: ${stats.newest ? new Date(stats.newest).toLocaleDateString() : 'N/A'}`));
    if (stats.total_size) {
      console.log(colors.gray(`Total size: ${(stats.total_size / 1024 / 1024).toFixed(2)} MB`));
    }

    // Folder breakdown
    const folders = db.prepare(`
      SELECT folder, COUNT(*) as count
      FROM email
      GROUP BY folder
      ORDER BY count DESC
    `).all();

    if (folders.length > 0) {
      console.log(colors.blue('\n📁 Emails by folder:'));
      for (const folder of folders) {
        console.log(colors.gray(`  ${folder.folder}: ${folder.count} emails`));
      }
    }

    // Source breakdown
    const sources = db.prepare(`
      SELECT source, COUNT(*) as count
      FROM email
      GROUP BY source
      ORDER BY count DESC
    `).all();

    if (sources.length > 0) {
      console.log(colors.blue('\n📧 Emails by source:'));
      for (const src of sources) {
        console.log(colors.gray(`  ${src.source}: ${src.count} emails`));
      }
    }

    console.log('');
    console.log(getSyncStatusMessage(db, 'email'));
  });

// List command - list recent emails
program
  .command('list')
  .description('List recent emails')
  .option('-d, --days <number>', 'Number of days of email to show', '7')
  .option('-l, --limit <number>', 'Number of emails to show')
  .option('-f, --from <email>', 'Filter by sender')
  .option('-s, --subject <text>', 'Filter by subject')
  .option('--folder <folder>', 'Filter by folder')
  .option('--source <source>', 'Filter by plugin source')
  .option('--unread', 'Show only unread emails')
  .action(async (options) => {
    const db = getDatabase();
    await ensureSyncForType(db, 'email');

    const conditions = [];
    const params = [];

    // Filter by days
    const days = parseInt(options.days);
    conditions.push("date >= datetime('now', ?)");
    params.push(`-${days} days`);

    // Exclude trash folders by default
    conditions.push("folder NOT LIKE '%Trash%'");
    conditions.push("folder NOT LIKE '%Deleted%'");

    if (options.from) {
      conditions.push('(from_address LIKE ? OR from_name LIKE ?)');
      params.push(`%${options.from}%`, `%${options.from}%`);
    }

    if (options.subject) {
      conditions.push('subject LIKE ?');
      params.push(`%${options.subject}%`);
    }

    if (options.folder) {
      conditions.push('folder LIKE ?');
      params.push(`%${options.folder}%`);
    }

    if (options.source) {
      addExactSourceCondition(conditions, params, options.source);
    }

    if (options.unread) {
      conditions.push("flags NOT LIKE '%seen%'");
    }

    const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(' AND ')}` : '';
    const limitClause = options.limit ? `LIMIT ${parseInt(options.limit)}` : '';

    const sql = `
      SELECT id, subject, from_address, from_name, date, folder, flags, source
      FROM email
      ${whereClause}
      ORDER BY date DESC
      ${limitClause}
    `;

    const emails = db.prepare(sql).all(...params);

    if (emails.length === 0) {
      console.log(colors.yellow('No emails found.'));
      return;
    }

    console.log(colors.blue(`\n📧 Recent Emails (${emails.length}):`));
    for (const email of emails) {
      const date = new Date(email.date).toLocaleDateString();
      const from = email.from_name || email.from_address;
      const subject = email.subject || '(no subject)';
      const flags = email.flags ? JSON.parse(email.flags) : [];
      const unreadMarker = flags.includes('seen') ? '' : colors.cyan('● ');

      console.log(`${unreadMarker}${colors.bold(subject)}`);
      console.log(`   From: ${from} | Date: ${date}`);
    }

    console.log('');
    console.log(getSyncStatusMessage(db, 'email'));
  });

// Search command - search emails
program
  .command('search <query>')
  .description('Search emails (use --server for historical IMAP search)')
  .option('-s, --server', 'Search IMAP server directly (for historical emails)')
  .option('-l, --limit <number>', 'Max results to return', '20')
  .option('--source <source>', 'Filter by plugin source')
  .action(async (query, options) => {
    if (options.server) {
      // Server search - connect to IMAP directly
      console.log(colors.blue(`🔍 Searching IMAP server for: ${query}`));

      // Dynamic imports for IMAP
      const { ImapFlow } = await import('imapflow');
      const toml = await import('smol-toml');
      const fs = await import('fs');
      const path = await import('path');

      // Load config to get IMAP settings
      let config;
      try {
        const configContent = fs.readFileSync(getConfigPath(), 'utf-8');
        config = toml.parse(configContent);
      } catch (e) {
        console.error(colors.red('Could not read config file'));
        process.exit(1);
      }

      // Find imap-email sources, applying --source filter if given
      const imapSources = [];
      for (const [sourceName, sourceConfig] of Object.entries(config.plugins?.['imap-email'] || {})) {
        if (sourceConfig.enabled && sourceConfig.host && sourceConfig.username) {
          if (options.source) {
            const sourceId = `imap-email/${sourceName}`;
            if (sourceId !== options.source && sourceName !== options.source) continue;
          }
          imapSources.push({ sourceName, ...sourceConfig });
        }
      }

      if (imapSources.length === 0) {
        console.log(colors.yellow('No IMAP email sources configured.'));
        console.log('Configure imap-email plugin in config.toml');
        process.exit(1);
      }

      const allResults = [];
      const limit = parseInt(options.limit);
      let foldersSearched = 0;
      let totalMatches = 0;

      // "ALL" is an IMAP criterion meaning every message; anything else is a text search
      const isAll = query.toUpperCase() === 'ALL';
      const searchCriteria = isAll
        ? { all: true }
        : { or: [{ subject: query }, { from: query }, { body: query }] };

      for (const source of imapSources) {
        const envKey = getImapPasswordEnvKey(source.sourceName);
        const password = process.env[envKey];
        if (!password) {
          console.log(colors.yellow(`Skipping ${source.sourceName}: password not found in ${envKey}`));
          continue;
        }

        console.log(colors.gray(`Searching ${source.sourceName}...`));

        const client = new ImapFlow({
          host: source.host,
          port: source.port || 993,
          secure: source.secure !== false,
          auth: { user: source.username, pass: password },
          logger: false
        });

        try {
          await withConnectedImapClient(client, async () => {
            const allFolders = await client.list();
            // ALL with no text query means list inbox; text queries search every folder
            const foldersToSearch = isAll ? ['INBOX'] : searchableFolders(allFolders);
            foldersSearched += foldersToSearch.length;

            for (const folder of foldersToSearch) {
              try {
                const lock = await client.getMailboxLock(folder);
                try {
                  // Ask for matching UIDs first. That is cheap, and it lets us
                  // fetch envelopes only for the newest candidates rather than
                  // walking a folder from its oldest message until a cap trips.
                  const uids = await client.search(searchCriteria, { uid: true });
                  if (!Array.isArray(uids) || uids.length === 0) continue;

                  totalMatches += uids.length;
                  const candidates = newestUids(uids, limit);

                  for await (const msg of client.fetch(
                    candidates, { envelope: true, size: true }, { uid: true }
                  )) {
                    allResults.push({
                      uid: msg.uid,
                      folder,
                      subject: msg.envelope?.subject || '(no subject)',
                      from: msg.envelope?.from?.[0]?.address || 'unknown',
                      date: msg.envelope?.date,
                      source: source.sourceName
                    });
                  }
                } finally {
                  lock.release();
                }
              } catch (e) {
                // Skip folders we can't access
              }
            }
          });
        } catch (e) {
          console.log(colors.yellow(`Could not search ${source.sourceName}: ${e.message}`));
        }
      }

      if (allResults.length === 0) {
        console.log(colors.yellow('No emails found matching your query.'));
      } else {
        // Rank once across every folder and source, then truncate. Doing this
        // per folder is what hid recent mail behind older matches.
        const ranked = rankSearchResults(allResults, limit);

        console.log(colors.green(`\n📧 Showing ${ranked.length} of ${totalMatches} matches across ${foldersSearched} folder(s):\n`));
        for (const email of ranked) {
          const date = email.date ? new Date(email.date).toLocaleDateString() : 'unknown';
          console.log(`${colors.bold(email.subject)}`);
          console.log(`   From: ${email.from} | Date: ${date} | Folder: ${email.folder}`);
        }
      }
    } else {
      // Local database search
      console.log(colors.blue(`🔍 Searching local cache for: ${query}`));

      const db = getDatabase();
      await ensureSyncForType(db, 'email');

      const conditions = [
        "(subject LIKE ? OR from_address LIKE ? OR from_name LIKE ? OR text_content LIKE ?)"
      ];
      const params = [`%${query}%`, `%${query}%`, `%${query}%`, `%${query}%`];

      // Exclude trash
      conditions.push("folder NOT LIKE '%Trash%'");
      conditions.push("folder NOT LIKE '%Deleted%'");

      if (options.source) {
        addExactSourceCondition(conditions, params, options.source);
      }

      const sql = `
        SELECT id, subject, from_address, from_name, date, folder, source
        FROM email
        WHERE ${conditions.join(' AND ')}
        ORDER BY date DESC
        LIMIT ?
      `;
      params.push(parseInt(options.limit));

      const emails = db.prepare(sql).all(...params);

      if (emails.length === 0) {
        console.log(colors.yellow('No emails found. Try --server to search IMAP directly.'));
      } else {
        console.log(colors.green(`\n📧 Found ${emails.length} emails:\n`));
        for (const email of emails) {
          const date = new Date(email.date).toLocaleDateString();
          const from = email.from_name || email.from_address;
          console.log(`${colors.bold(email.subject || '(no subject)')}`);
          console.log(`   From: ${from} | Date: ${date}`);
        }
      }

      console.log('');
      console.log(getSyncStatusMessage(db, 'email'));
    }
  });

// Download command - fetch a specific email body by ID
program
  .command('download [emailId]')
  .description('Fetch specific email body by ID (e.g., imap-email/icloud:INBOX:196336)')
  .action(async (emailId) => {
    if (!emailId) {
      console.log(colors.blue('📧 To fetch a specific email body, provide the email ID.'));
      console.log(colors.gray('Format: source:folder:uid'));
      console.log(colors.gray('Example: bin/email download "imap-email/icloud:INBOX:196336"'));
      console.log('');
      console.log('To sync all emails, run: bin/plugins sync imap-email');
      return;
    }

    // Parse the email ID
    const match = emailId.match(/^([^:]+\/[^:]+):(.+):(\d+)$/);
    if (!match) {
      console.error(colors.red('Invalid email ID format. Expected: source:folder:uid'));
      console.error(colors.gray('Example: imap-email/icloud:INBOX:196336'));
      process.exit(1);
    }

    const [, sourceId, folder, uidStr] = match;
    const uid = parseInt(uidStr);
    const [pluginName, sourceName] = sourceId.split('/');

    console.log(colors.blue(`📧 Fetching email body: ${emailId}`));

    // Dynamic imports
    const { ImapFlow } = await import('imapflow');
    const { simpleParser } = await import('mailparser');
    const Database = (await import('better-sqlite3')).default;
    const toml = await import('smol-toml');
    const fs = await import('fs');
    const path = await import('path');

    // Load config to get IMAP settings
    let config;
    try {
      const configContent = fs.readFileSync(getConfigPath(), 'utf-8');
      config = toml.parse(configContent);
    } catch (e) {
      console.error(colors.red('Could not read config file'));
      process.exit(1);
    }

    const sourceConfig = config.plugins?.[pluginName]?.[sourceName];
    if (!sourceConfig) {
      console.error(colors.red(`Source not found in config: ${sourceId}`));
      process.exit(1);
    }

    const { host, port = 993, secure = true, username } = sourceConfig;
    const envKey = getImapPasswordEnvKey(sourceName);
    const password = process.env[envKey];

    if (!password) {
      console.error(colors.red(`Password not found in ${envKey}`));
      process.exit(1);
    }

    // Connect to IMAP
    const client = new ImapFlow({
      host,
      port,
      secure,
      auth: { user: username, pass: password },
      logger: false
    });

    try {
      await withConnectedImapClient(client, async () => {
        const lock = await client.getMailboxLock(folder);

        try {
          const message = await client.fetchOne(uid, { source: true }, { uid: true });

          if (!message || !message.source) {
            console.error(colors.red('Email not found or no content'));
            process.exit(1);
          }

          const parsed = await simpleParser(message.source);
          let textContent = parsed.text || '';
          let htmlContent = parsed.html || '';
          const attachments = parsed.attachments?.map(a => ({
            filename: a.filename,
            contentType: a.contentType,
            size: a.size
          })) || [];

          const maxBodySize = 50000;
          if (textContent.length > maxBodySize) {
            textContent = textContent.substring(0, maxBodySize) + '\n[truncated]';
          }
          if (htmlContent.length > maxBodySize) {
            htmlContent = htmlContent.substring(0, maxBodySize) + '\n[truncated]';
          }

          const snippet = textContent
            ? textContent.substring(0, 200).replace(/\s+/g, ' ').trim()
            : '';

          // Update database
          const dbPath = path.join(process.cwd(), '.data', 'today.db');
          const db = new Database(dbPath, { timeout: 30000 });
          db.pragma('journal_mode = WAL');
          db.pragma('busy_timeout = 30000');

          const result = db.prepare(`
            UPDATE email
            SET snippet = ?, text_content = ?, html_content = ?, attachments = ?,
                metadata = json_set(COALESCE(metadata, '{}'), '$.needs_body', false)
            WHERE id = ?
          `).run(
            snippet,
            textContent,
            htmlContent,
            attachments.length > 0 ? JSON.stringify(attachments) : null,
            emailId
          );

          db.close();

          if (result.changes > 0) {
            console.log(colors.green('✓ Email body fetched and saved'));
            console.log(colors.gray(`  Snippet: ${snippet.substring(0, 80)}...`));
            if (attachments.length > 0) {
              console.log(colors.gray(`  Attachments: ${attachments.map(a => a.filename).join(', ')}`));
            }
          } else {
            console.log(colors.yellow('Email not found in database'));
          }
        } finally {
          lock.release();
        }
      });
    } catch (e) {
      console.error(colors.red(`Error: ${e.message}`));
      process.exit(1);
    }
  });

// Find a special-use folder (RFC 6154) with name fallbacks
function findSpecialFolder(folders, specialUseAttr, fallbackPaths) {
  return folders.find(f => {
    const use = f.specialUse;
    if (use === specialUseAttr) return true;
    if (Array.isArray(use) && use.includes(specialUseAttr)) return true;
    return fallbackPaths.some(p => f.path === p || f.path.toLowerCase() === p.toLowerCase());
  });
}

// Shared action factory for delete/spam/move commands
// destFallbacks, destLabel, confirmVerb may be functions receiving (options)
function makeMoveAction({ destSpecialUse, destFallbacks, destLabel, confirmVerb }) {
  return async function(options) {
    const resolvedFallbacks = typeof destFallbacks === 'function' ? destFallbacks(options) : destFallbacks;
    const resolvedLabel = typeof destLabel === 'function' ? destLabel(options) : destLabel;
    const resolvedVerb = typeof confirmVerb === 'function' ? confirmVerb(options) : confirmVerb;
    destFallbacks = resolvedFallbacks;
    destLabel = resolvedLabel;
    confirmVerb = resolvedVerb;

    const db = getDatabase();

    if (!options.body && !options.subject && !options.from) {
      console.error(colors.red('At least one of --body, --subject, or --from is required.'));
      process.exit(1);
    }

    const conditions = [`folder = ?`];
    const params = [options.folder];

    if (options.body) {
      conditions.push('(text_content LIKE ? OR html_content LIKE ?)');
      params.push(`%${options.body}%`, `%${options.body}%`);
    }
    if (options.subject) {
      conditions.push('subject LIKE ?');
      params.push(`%${options.subject}%`);
    }
    if (options.from) {
      conditions.push('(from_address LIKE ? OR from_name LIKE ?)');
      params.push(`%${options.from}%`, `%${options.from}%`);
    }
    if (options.days) {
      // datetime(date) normalises the stored ISO-8601 value before comparing
      conditions.push("datetime(date) >= datetime('now', ?)");
      params.push(`-${parseInt(options.days)} days`);
    }
    if (options.source) {
      addExactSourceCondition(conditions, params, options.source);
    }

    const emails = db.prepare(`
      SELECT id, subject, from_address, from_name, date, source, folder
      FROM email
      WHERE ${conditions.join(' AND ')}
      ORDER BY date DESC
    `).all(...params);

    if (emails.length === 0) {
      console.log(colors.yellow('No matching emails found.'));
      return;
    }

    console.log(colors.blue(`\n📧 ${emails.length} email(s) to move to ${destLabel}:\n`));
    for (const email of emails) {
      const date = new Date(email.date).toLocaleDateString();
      const from = email.from_name || email.from_address;
      console.log(`  ${colors.bold(email.subject || '(no subject)')}`);
      console.log(colors.gray(`   From: ${from} | Date: ${date} | ${email.source}`));
    }
    console.log('');

    if (!options.yes) {
      const { createInterface } = await import('readline');
      const rl = createInterface({ input: process.stdin, output: process.stdout });
      const answer = await new Promise(resolve => rl.question(`${confirmVerb} ${emails.length} message(s)? [y/N] `, resolve));
      rl.close();
      if (answer.toLowerCase() !== 'y') {
        console.log(colors.yellow('Aborted.'));
        return;
      }
    }

    const { ImapFlow } = await import('imapflow');
    const toml = await import('smol-toml');
    const fs = await import('fs');
    const { getConfigPath: cfgPath } = await import('../src/config.js');

    const configContent = fs.readFileSync(cfgPath(), 'utf-8');
    const tomlConfig = toml.parse(configContent);

    const bySource = {};
    for (const email of emails) {
      const match = email.id.match(/^imap-email\/([^:]+):(.+):(\d+)$/);
      if (!match) { console.warn(colors.yellow(`Skipping unrecognised id: ${email.id}`)); continue; }
      const [, sourceName, folder, uid] = match;
      const key = `${sourceName}::${folder}`;
      if (!bySource[key]) bySource[key] = { sourceName, folder, uids: [], ids: [] };
      bySource[key].uids.push(parseInt(uid));
      bySource[key].ids.push(email.id);
    }

    let totalMoved = 0;
    let hadError = false;
    for (const { sourceName, folder, uids, ids } of Object.values(bySource)) {
      const sourceConfig = tomlConfig.plugins?.['imap-email']?.[sourceName];
      if (!sourceConfig) { console.error(colors.red(`No config for source: ${sourceName}`)); hadError = true; continue; }

      const envKey = getImapPasswordEnvKey(sourceName);
      const password = process.env[envKey];
      if (!password) { console.error(colors.red(`Password not found for ${sourceName} (env: ${envKey})`)); hadError = true; continue; }

      const client = new ImapFlow({
        host: sourceConfig.host,
        port: sourceConfig.port || 993,
        secure: sourceConfig.secure !== false,
        auth: { user: sourceConfig.username, pass: password },
        logger: false,
      });

      let connected = false;
      try {
        await client.connect();
        connected = true;

        const allFolders = await client.list();
        const destFolder = destSpecialUse
          ? findSpecialFolder(allFolders, destSpecialUse, destFallbacks)
          : allFolders.find(f => destFallbacks.some(p => f.path === p));

        if (!destFolder) {
          console.error(colors.red(`Could not find ${destLabel} folder on ${sourceName}. Available: ${allFolders.map(f => f.path).join(', ')}`));
          hadError = true;
        } else if (folder === destFolder.path) {
          console.log(colors.yellow(`Messages in ${sourceName}/${folder} are already in ${destFolder.path}, skipping.`));
        } else {
          const lock = await client.getMailboxLock(folder);
          try {
            await client.messageMove(uids, destFolder.path, { uid: true });
            // Delete cache rows: after a move the destination UID differs from the source UID,
            // so updating the folder would leave stale ids. The sync will re-index them.
            const placeholders = ids.map(() => '?').join(',');
            db.prepare(`DELETE FROM email WHERE id IN (${placeholders})`).run(...ids);
            console.log(colors.green(`✓ Moved ${uids.length} message(s) from ${sourceName}/${folder} → ${destFolder.path}`));
            totalMoved += uids.length;
          } finally {
            lock.release();
          }
        }
      } catch (e) {
        console.error(colors.red(`Error with ${sourceName}: ${e.message}`));
        hadError = true;
      } finally {
        if (connected) {
          try { await client.logout(); } catch { /* ignore logout errors */ }
        }
      }
    }

    if (totalMoved > 0) {
      console.log(colors.green(`\n✓ Done. ${totalMoved} message(s) moved to ${destLabel}.`));
    }
    if (hadError) process.exitCode = 1;
  };
}

const MOVE_OPTIONS = (cmd) => cmd
  .option('--body <text>', 'Match emails whose body contains this text')
  .option('--subject <text>', 'Match emails whose subject contains this text')
  .option('--from <email>', 'Match emails from this sender')
  .option('-d, --days <number>', 'Only look at emails from the last N days')
  .option('--folder <folder>', 'Source folder to search (default: INBOX)', 'INBOX')
  .option('--source <source>', 'Filter by plugin source (e.g. icloud, pobox)')
  .option('-y, --yes', 'Skip confirmation prompt');

// delete command - move matching emails to trash
MOVE_OPTIONS(
  program
    .command('delete')
    .description('Move matching emails to trash')
).action(makeMoveAction({
  destSpecialUse: '\\Trash',
  destFallbacks: ['Deleted Messages', 'Trash', 'Deleted Items'],
  destLabel: 'trash',
  confirmVerb: 'Delete',
}));

// spam command - move matching emails to spam/junk
MOVE_OPTIONS(
  program
    .command('spam')
    .description('Move matching emails to spam/junk folder')
).action(makeMoveAction({
  destSpecialUse: '\\Junk',
  destFallbacks: ['Junk', 'Spam', 'Junk Email', 'Junk E-mail', 'Bulk Mail'],
  destLabel: 'spam',
  confirmVerb: 'Mark as spam',
}));

// move command - move matching emails to any named folder
MOVE_OPTIONS(
  program
    .command('move')
    .description('Move matching emails to a named folder')
    .requiredOption('--to <folder>', 'Destination folder name (exact path on server)')
).action(makeMoveAction({
  destSpecialUse: null,
  destFallbacks: (options) => [options.to],
  destLabel: (options) => options.to,
  confirmVerb: (options) => `Move to ${options.to}`,
}));

// Setup command - show setup instructions
program
  .command('setup')
  .description('Setup email account credentials')
  .action(async () => {
    console.log(colors.blue('📧 Email Account Setup'));
    console.log(colors.yellow('\nFor iCloud/Apple Mail:'));
    console.log('1. Go to https://appleid.apple.com');
    console.log('2. Sign in and go to "Sign-In and Security"');
    console.log('3. Select "App-Specific Passwords"');
    console.log('4. Generate a new password for "today-cli email"');
    console.log('5. Add the password to your .env file');
    console.log(colors.green('\nExample .env entry:'));
    console.log('EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx');
    console.log(colors.gray('\nThen configure imap-email plugin in config.toml'));
  });

// Sync command - shorthand for bin/plugins sync imap-email
program
  .command('sync')
  .description('Sync emails from IMAP servers')
  .action(async () => {
    console.log(colors.blue('📧 Syncing emails...'));
    const { execSync } = await import('child_process');
    try {
      execSync('bin/plugins sync imap-email', { stdio: 'inherit' });
    } catch (e) {
      // execSync throws on non-zero exit, but output is already shown
    }
  });

program.parse();
