# Today environment variables
#
# Copy only the variables you need into .env, then encrypt them with dotenvx:
#   npx dotenvx set KEY "value"
#
# Or use the interactive setup:
#   bin/today configure
#
# Required variables depend on which features you enable. Most non-secret settings
# live in config.toml; .env is only for secrets and runtime overrides.

# =============================================================================
# Required for cloud AI providers (choose the provider you actually use)
# =============================================================================

# Required when [ai].provider or [ai].interactive_provider uses "anthropic-api"
# TODAY_ANTHROPIC_KEY=replace-with-your-anthropic-api-key

# Optional legacy alias for Anthropic API access
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Required when using OpenAI models
# OPENAI_API_KEY=replace-with-your-openai-api-key
# Optional custom API endpoint (Azure OpenAI or compatible gateway)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Required when using Google Gemini models
# GOOGLE_API_KEY=replace-with-your-google-ai-api-key
# Optional alias accepted by Today
# GEMINI_API_KEY=replace-with-your-google-ai-api-key

# Optional for Ollama on a non-default host
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434/api

# Optional legacy API model override. Prefer config.toml instead.
# CLAUDE_MODEL=claude-sonnet-4-20250514

# =============================================================================
# Optional web interface
# =============================================================================

# Default: 3000
# WEB_PORT=3000

# Default: admin
# WEB_USER=admin

# Optional but recommended for predictable logins. If unset, Today generates one
# and stores it encrypted in .env the first time the web server starts.
# WEB_PASSWORD=replace-with-a-long-random-password

# Optional but strongly recommended in production. If unset, Today generates a
# random secret at startup, which invalidates sessions after a restart.
# Generate with: openssl rand -hex 32
# SESSION_SECRET=replace-with-a-random-64-character-hex-string

# =============================================================================
# Optional inbox upload API
# =============================================================================

# Default: 3333
# INBOX_API_PORT=3333

# Optional but recommended. If unset, a random key is generated at startup and
# printed in development logs.
# Generate with: openssl rand -hex 32
# INBOX_API_KEY=replace-with-a-random-api-key

# =============================================================================
# Optional deployment and container runtime settings
# =============================================================================

# Container/service timezone. docker-compose.scheduler.yml defaults to
# America/New_York if unset.
# TZ=America/New_York

# Required on any machine that needs to decrypt encrypted .env values.
# This value lives in .env.keys and should never be committed.
# DOTENV_PRIVATE_KEY=replace-with-your-dotenvx-private-key

# Optional deployment IP lookup for bin/deploy.
# Modern naming pattern: DEPLOY_<PROVIDER>_<NAME>_IP
# DEPLOY_DIGITALOCEAN_PRODUCTION_IP=203.0.113.10
# Legacy alias still supported for digitalocean/production:
# DO_DROPLET_IP=203.0.113.10

# Optional when a deployed server needs HTTPS git credentials for git push/pull.
# Prefer SSH remotes when possible.
# GITHUB_TOKEN=replace-with-a-github-token

# Legacy deploy-key variables used by some devcontainer/unison workflows.
# Prefer bin/today configure and standard SSH keys for new setups.
# DO_DEPLOY_KEY_PRIVATE=replace-with-an-ssh-private-key
# DO_DEPLOY_KEY_PUBLIC=replace-with-an-ssh-public-key

# =============================================================================
# Optional runtime/debug overrides
# =============================================================================

# Use a non-default config file. Default: config.toml
# TODAY_CONFIG=/absolute/path/to/config.toml

# Suppress some CLI output when set to 1
# TODAY_QUIET=1

# Skip dependency install/update checks in automation or containers
# SKIP_DEP_CHECK=true
# SKIP_UPDATE_CHECK=1

# Skip database health checks on startup
# SKIP_DB_HEALTH=1

# Skip context gathering / cache for debugging and tests
# SKIP_CONTEXT=true
# SKIP_CONTEXT_CACHE=1

# Enable verbose logs
# DEBUG=true
# DEBUG_AI=true

# Force the built-in REPL instead of Claude Code CLI for interactive Anthropic use
# USE_BUILTIN_REPL=true

# =============================================================================
# Plugin secrets (normally managed automatically by bin/today configure)
# =============================================================================

# Secret plugin settings are stored as TODAY_<PLUGIN>_<SOURCE>_<SETTING>.
# The source name lets you keep separate credentials for personal/work accounts.

# IMAP email password example (username/host stay in config.toml)
# TODAY_IMAP_EMAIL_PERSONAL_PASSWORD=replace-with-an-app-password

# Google Calendar service account key example (base64-encoded JSON key)
# TODAY_GOOGLE_CALENDAR_PERSONAL_SERVICE_ACCOUNT_KEY=replace-with-base64-json

# Front plugin example
# TODAY_FRONT_CONVERSATIONS_WORK_API_TOKEN=replace-with-a-front-api-token

# Healthchecks.io plugin example
# TODAY_HEALTHCHECKS_IO_DEFAULT_API_KEY=replace-with-a-healthchecks-api-key

# iCloud Contacts plugin example (use an Apple app-specific password)
# TODAY_ICLOUD_CONTACTS_DEFAULT_APP_PASSWORD=replace-with-an-apple-app-password

# Sentry plugin example
# TODAY_SENTRY_ISSUES_DEFAULT_AUTH_TOKEN=replace-with-a-sentry-auth-token

# YNAB plugin example
# TODAY_YNAB_API_DEFAULT_API_TOKEN=replace-with-a-ynab-access-token
